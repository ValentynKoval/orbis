# Public URL of the site (used for metadata and OG images).
NEXT_PUBLIC_SITE_URL=https://orbis-live.vercel.app

# Optional: ArcGIS Location Platform key (free tier) for sub-metre imagery when zoomed in.
# Without it the globe stops at Sentinel-2 (10 m). Restrict the key to this site's domain.
# NEXT_PUBLIC_ARCGIS_KEY=

# Stage 2 (planes, ships): relay credentials, set on the relay, never in the browser.
# OPENSKY_CLIENT_ID=
# OPENSKY_CLIENT_SECRET=
# AISSTREAM_API_KEY=

# Stage 3 (AI analyst): Gemini free tier.
# GEMINI_API_KEY=
